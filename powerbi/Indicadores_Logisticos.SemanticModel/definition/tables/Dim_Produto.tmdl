	partition Dim_Produto = m
		mode: import
		source =
				let
				    Fonte = Value.NativeQuery(PostgreSQL.Database("estudos-dev01.c1me8kw6qipl.us-east-2.rds.amazonaws.com", "northwind"), "SELECT cod_produto, #(lf)#(tab)nome_produto, #(lf)#(tab)cod_categoria, #(lf)#(tab)status, #(lf)#(tab)nome_categoria, #(lf)#(tab)descricao, #(lf)#(tab)data_execucao, #(lf)#(tab)cod_fornecedor, #(lf)#(tab)preco_unitario, #(lf)#(tab)qtd_livre, #(lf)#(tab)qtd_reservada, #(lf)#(tab)qtd_minima, #(lf)#(tab)status_desc#(lf)FROM dw.dim_produtos dp #(lf)where exists (select 1#(lf)#(tab)#(tab)#(tab)  from dw.fato_pedidos fp #(lf)#(tab)#(tab)#(tab)  where dp.cod_produto = fp.cod_produto)", null, [EnableFolding=true])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

