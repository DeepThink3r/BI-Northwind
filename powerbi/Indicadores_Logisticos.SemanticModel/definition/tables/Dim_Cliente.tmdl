	partition Dim_Cliente = m
		mode: import
		source =
				let
				    Fonte = Value.NativeQuery(PostgreSQL.Database("estudos-dev01.c1me8kw6qipl.us-east-2.rds.amazonaws.com", "northwind"), "SELECT cod_cliente, #(lf)#(tab)nome_empresa, #(lf)#(tab)nome_contato, #(lf)#(tab)nome_cargo, #(lf)#(tab)regiao, #(lf)#(tab)pais#(lf)FROM dw.dim_cliente a#(lf)WHERE EXISTS (select 1#(lf)#(tab)#(tab)#(tab)  from dw.fato_pedidos fp #(lf)#(tab)#(tab)#(tab)  where a.cod_cliente = fp.cod_cliente)", null, [EnableFolding=true])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

