	partition Fato_Pedido = m
		mode: import
		source =
				let
				    Fonte = Value.NativeQuery(PostgreSQL.Database("estudos-dev01.c1me8kw6qipl.us-east-2.rds.amazonaws.com", "northwind"), "SELECT cod_pedido, #(lf)#(tab)cod_cliente, #(lf)#(tab)cod_funcionario, #(lf)#(tab)data_pedido::date as data_pedido, #(lf)#(tab)data_desejada, #(lf)#(tab)data_expedicao, #(lf)#(tab)cod_expedidor, #(lf)#(tab)regiao_expedicao, #(lf)#(tab)pais_extedicao, #(lf)#(tab)cod_produto, #(lf)#(tab)quantidade, #(lf)#(tab)val_pedido#(lf)FROM dw.fato_pedidos", null, [EnableFolding=true])
				in
				    Fonte

