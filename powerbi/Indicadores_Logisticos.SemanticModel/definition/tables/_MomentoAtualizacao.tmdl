table _MomentoAtualizacao
	lineageTag: db366c24-23c4-4452-8b18-6e6ee17afffe

	column Atualização
		dataType: dateTime
		formatString: General Date
		lineageTag: 96b302f6-1400-4063-b0b8-1d286e210971
		summarizeBy: none
		sourceColumn: Atualização

		variation Variation
			isDefault
			relationship: 31ec8d85-b494-46ee-9f5a-25cd32295972
			defaultHierarchy: LocalDateTable_d9ec1df6-eb16-4663-88f2-2b186d60e945.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	partition _MomentoAtualizacao = m
		mode: import
		source =
				let
				    // Pega a hora universal (UTC 0) para evitar variação de servidor
				    Fonte = DateTimeZone.UtcNow(),
				    // Ajusta para o fuso de Brasília (-3) de forma fixa
				    BrasiliaTime = DateTimeZone.SwitchZone(Fonte, -3),
				    #"Convertido para Tabela" = #table(1, {{BrasiliaTime}}),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Convertido para Tabela",{{"Column1", "Atualização"}}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Colunas Renomeadas",{{"Atualização", type datetimezone}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

