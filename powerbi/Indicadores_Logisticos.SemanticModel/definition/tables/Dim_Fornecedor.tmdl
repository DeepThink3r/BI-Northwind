	partition Dim_Fornecedor = m
		mode: import
		source =
				let
				    Fonte = Value.NativeQuery(PostgreSQL.Database("estudos-dev01.c1me8kw6qipl.us-east-2.rds.amazonaws.com", "northwind"), "SELECT cod_fornecedor, #(lf)#(tab)nome_empresa#(lf)FROM dw.dim_fornecedor df #(lf)WHERE exists (select 1#(lf)#(tab)#(tab)#(tab)  from dw.dim_produtos dp#(lf)#(tab)#(tab)#(tab)  where df.cod_fornecedor = dp.cod_fornecedor)", null, [EnableFolding=true])
				in
