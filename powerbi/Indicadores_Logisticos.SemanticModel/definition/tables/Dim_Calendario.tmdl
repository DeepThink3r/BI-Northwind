	partition Dim_Calendario = m
		mode: import
		source =
				let
				    Fonte = Value.NativeQuery(PostgreSQL.Database("estudos-dev01.c1me8kw6qipl.us-east-2.rds.amazonaws.com", "northwind"), "SELECT sk_tempo, #(lf)#(tab)data_completa, #(lf)#(tab)ano, #(lf)#(tab)mes, #(lf)#(tab)dia, #(lf)#(tab)dia_ano, #(lf)#(tab)trimestre, #(lf)#(tab)semestre, #(lf)#(tab)nome_mes, #(lf)#(tab)nome_dia_semana, #(lf)#(tab)dia_semana_num, #(lf)#(tab)fim_semana, #(lf)#(tab)mes_ano#(lf)FROM dw.dim_tempo dt #(lf)where exists (select 1#(lf)#(tab)#(tab)#(tab)  from dw.fato_pedidos fp #(lf)#(tab)#(tab)#(tab)  where dt.data_completa = fp.data_pedido::date)", null, [EnableFolding=true])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

