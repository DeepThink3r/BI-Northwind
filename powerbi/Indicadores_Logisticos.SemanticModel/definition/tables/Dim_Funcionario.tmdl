	partition Dim_Funcionario = m
		mode: import
		source =
				let
				    Fonte = Value.NativeQuery(PostgreSQL.Database("estudos-dev01.c1me8kw6qipl.us-east-2.rds.amazonaws.com", "northwind"), "SELECT cod_funcionario, #(lf)#(tab)cargo, #(lf)#(tab)nome_completo#(lf)FROM dw.dim_funcionario df #(lf)where exists (select 1#(lf)#(tab)#(tab)#(tab)  from dw.fato_pedidos fp#(lf)#(tab)#(tab)#(tab)  where df.cod_funcionario = fp.cod_funcionario)", null, [EnableFolding=true])
				in
				    Fonte

